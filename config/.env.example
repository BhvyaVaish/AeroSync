# ==============================================================================
# AeroSync Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values before running the application.
# NEVER commit .env to version control.
# ==============================================================================

# --- Relay Server ---
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Database ---
# For local development, SQLite is used by default.
# Set DATABASE_URL to use a different database.
DATABASE_URL=sqlite+aiosqlite:///./aerosync.db

# --- Supabase (optional, replaces SQLite when configured) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=session-packages

# --- Server ---
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=DEBUG
ALLOWED_ORIGINS=http://localhost:1420,http://localhost:5173,tauri://localhost

# --- Client (desktop app) ---
RELAY_SERVER_URL=http://localhost:8000
GESTURE_ENGINE_PORT=7878
CHROME_DEBUG_PORT=9222

# --- Session Packages ---
SESSION_PACKAGE_MAX_SIZE_MB=50
SESSION_EXPIRY_MINUTES=30
SESSION_CLEANUP_INTERVAL_MINUTES=5

# --- AI & Screen Reader (Windows only) ---
# Google Gemini API key for intelligent screen content analysis & planning
GEMINI_API_KEY=
SCREEN_READER_ENABLED=true
